# Copy to .env and fill in. Never commit .env.

# --- LLM provider -------------------------------------------------------------
# ollama (first production runtime, local, no API key) | openai (future)
LLM_PROVIDER=ollama

# Model for the selected provider. Required for Ollama: must be a model you have
# pulled (`ollama pull qwen2.5:7b`). For OpenAI it defaults to gpt-5.6-luna.
LEAD_INTEL_LLM_MODEL=qwen2.5:7b

# Ollama server (default http://localhost:11434). CrewAI appends /v1.
# OLLAMA_HOST=http://localhost:11434

# Local CPU inference is slow; allow long single responses (seconds).
LEAD_INTEL_LLM_TIMEOUT_SECONDS=1800

# Optional. Low temperature helps local models follow the JSON schema.
# Leave unset for OpenAI GPT-5-family models (they only accept the default).
LEAD_INTEL_LLM_TEMPERATURE=0.1

# Only required when LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# --- Search provider ------------------------------------------------------------
LEAD_INTEL_SEARCH_PROVIDER=tavily
# Required when LEAD_INTEL_SEARCH_PROVIDER=tavily.
TAVILY_API_KEY=
LEAD_INTEL_TAVILY_MAX_RESULTS=5

# --- Workflow ---------------------------------------------------------------------
LEAD_INTEL_GUARDRAIL_MAX_RETRIES=2

# Ideal Customer Profile the agent judges "ICP fit" against.
LEAD_INTEL_ICP_DESCRIPTION=Small and medium-sized service businesses that handle customer inquiries, bookings or quotes and would benefit from AI automation.

# --- Inbound enquiry processing (lead_intel.inbound) -----------------------------
# Uses the LLM settings above; never reads Tavily settings.
LEAD_OPS_BUSINESS_CONFIG_PATH=config/businesses/example-dental-clinic.json
LEAD_OPS_EXTRACTION_MAX_RETRIES=2

# --- Supabase ---------------------------------------------------------------------
SUPABASE_URL=https://pcntqnbhhqryfzpnporw.supabase.co
SUPABASE_ANON_KEY=

